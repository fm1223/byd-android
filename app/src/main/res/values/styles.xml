<resources>
<style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/accent</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/page</item><item name="android:navigationBarColor">@color/surface</item><item name="android:windowBackground">@color/page</item><item name="android:textColorPrimary">@color/ink</item><item name="android:textColorSecondary">@color/muted</item><item name="android:buttonStyle">@style/ActionButton</item><item name="android:editTextStyle">@style/Field</item></style>
<style name="Card"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:background">@drawable/card_surface</item><item name="android:padding">16dp</item><item name="android:layout_marginTop">16dp</item></style>
<style name="Title"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">28sp</item><item name="android:textColor">@color/ink</item><item name="android:textStyle">bold</item></style>
<style name="Section"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">18sp</item><item name="android:textColor">@color/ink</item><item name="android:textStyle">bold</item><item name="android:layout_marginBottom">12dp</item></style>
<style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">15sp</item><item name="android:textColor">@color/ink</item><item name="android:lineSpacingExtra">5dp</item></style>
<style name="Caption" parent="Body"><item name="android:textSize">13sp</item><item name="android:textColor">@color/muted</item></style>
<style name="ActionButton" parent="android:style/Widget.Material.Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item><item name="android:background">@drawable/button_soft</item><item name="android:textColor">@color/accent</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:layout_marginTop">12dp</item><item name="android:stateListAnimator">@null</item></style>
<style name="PrimaryButton" parent="ActionButton"><item name="android:background">@drawable/button_primary</item><item name="android:textColor">@color/button_primary_text</item></style>
<style name="Field" parent="android:style/Widget.Material.EditText"><item name="android:background">@drawable/field_surface</item><item name="android:padding">14dp</item><item name="android:minHeight">56dp</item><item name="android:textColor">@color/ink</item><item name="android:textColorHint">@color/muted</item><item name="android:textSize">15sp</item><item name="android:layout_marginTop">12dp</item></style>
<style name="NavButton" parent="ActionButton"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">56dp</item><item name="android:minHeight">0dp</item><item name="android:minWidth">0dp</item><item name="android:textSize">12sp</item><item name="android:gravity">center</item><item name="android:includeFontPadding">false</item><item name="android:layout_marginTop">0dp</item><item name="android:background">?android:attr/selectableItemBackground</item><item name="android:textColor">@color/muted</item></style>
</resources>